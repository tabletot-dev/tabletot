ANTHROPIC_API_KEY=your_anthropic_api_key
SARVAM_API_KEY=your_sarvam_api_subscription_key

# LLM provider selection — choose one: claude | openai | gemini
LLM_PROVIDER=claude

# Model override — must be set explicitly. If blank, provider default is used.
# Claude:  claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
# OpenAI:  gpt-4o-mini | gpt-4o
# Gemini:  gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-pro
LLM_MODEL=

OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
