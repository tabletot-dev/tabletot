VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Restaurant this POS deployment manages. Must match restaurants.id in Supabase.
# TODO: set to Silver Specialty Coffee UUID — run: SELECT id FROM restaurants WHERE name = 'Silver Specialty Coffee';
VITE_RESTAURANT_ID=
# Order-engine base URL, for the "refresh voice menu" call after menu edits.
# Leave blank to skip the call entirely (Menu.tsx no-ops without it).
VITE_VOICE_ENGINE_URL=
# Must match ADMIN_API_KEY on the order-engine service (Railway env var).
VITE_VOICE_ADMIN_KEY=
# Curation dashboard base URL (apps/dashboard). Adds a "See full AOV lift
# breakdown" link on Reports → Summary. Leave blank to hide the link.
VITE_DASHBOARD_URL=
